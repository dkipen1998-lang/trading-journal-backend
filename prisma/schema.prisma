generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeSide {
  long
  short
}

enum TradeStatus {
  open
  closed
}

enum ImageType {
  entry
  exit
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  photoUrl   String?  @map("photo_url")
  createdAt  DateTime @default(now()) @map("created_at")

  trades Trade[]
  tags   Tag[]
  setups Setup[]
  profiles Profile[]

  @@map("users")
}

model Trade {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?     @map("profile_id")
  profile   Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)

  ticker String
  side   TradeSide
  status TradeStatus @default(open)

  entryDate    DateTime @map("entry_date") @db.Date
  entryTime    String?  @map("entry_time") // stored HH:MM
  entryPrice   Decimal  @map("entry_price") @db.Decimal(18, 6)
  stopLoss     Decimal? @map("stop_loss") @db.Decimal(18, 6)
  takeProfit   Decimal? @map("take_profit") @db.Decimal(18, 6)
  positionSize Decimal? @map("position_size") @db.Decimal(18, 6)
  riskDollar   Decimal? @map("risk_dollar") @db.Decimal(18, 2)
  riskPercent  Decimal? @map("risk_percent") @db.Decimal(6, 2)
  timeframe    String?

  exitDate   DateTime? @map("exit_date") @db.Date
  exitTime   String?   @map("exit_time")
  exitPrice  Decimal?  @map("exit_price") @db.Decimal(18, 6)
  exitReason String?   @map("exit_reason")
  pnl        Decimal?  @db.Decimal(18, 2)
  pnlPercent Decimal?  @map("pnl_percent") @db.Decimal(8, 2)
  rMultiple  Decimal?  @map("r_multiple") @db.Decimal(8, 2)

  setup       String?
  notes       String?
  postComment String? @map("post_comment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images    TradeImage[]
  tradeTags TradeTag[]

  @@index([userId, status])
  @@index([userId, entryDate(sort: Desc)])
  @@index([userId, ticker])
  @@map("trades")
}

model TradeImage {
  id        String    @id @default(uuid())
  tradeId   String    @map("trade_id")
  trade     Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  imageType ImageType @map("image_type")
  imageUrl  String    @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("trade_images")
}

model Tag {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  tradeTags TradeTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TradeTag {
  tradeId String @map("trade_id")
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tagId   String @map("tag_id")
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@map("trade_tags")
}

model Setup {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  @@unique([userId, name])
  @@map("setups")
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  defaultRiskPerTrade Decimal? @map("default_risk_per_trade") @db.Decimal(18, 2)
  accountSize        Decimal? @map("account_size") @db.Decimal(18, 2)
  settings           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  trades             Trade[]

  @@unique([userId, name])
  @@map("profiles")
}
