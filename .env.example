# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_journal?schema=public"

# Get this from @BotFather when you create your Telegram bot
TELEGRAM_BOT_TOKEN="123456789:AA...your-bot-token"

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# How long issued JWTs stay valid
JWT_EXPIRES_IN="30d"

# AI provider configuration: use "gemini" for the free Google AI Studio option
AI_PROVIDER="gemini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash-lite"

PORT=3000

# Optional — only needed if you wire up real S3/Cloudinary uploads for images
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Do not commit your real .env file to GitHub.
# In production, set these values in Render/Firebase/hosting environment variables.
